# Build configuration for scripts/build_lila.py (the Lila build wrapper).
#
# Copy this file to `.env` and edit it, then run:
#     python scripts/build_lila.py
#
# Every value is optional: omitted or empty settings fall back to the Lila
# defaults shown below. `.env` is git-ignored because it may contain secrets.

# --- Board ---
# Board directory under main/boards and its build variant name (the OTA-reported
# board identity; keep it unchanged unless you add a new variant in config.json).
LILA_BOARD=wk-esp32s3-dev
LILA_NAME=wk-esp32s3-dev

# Display language locale.
LILA_LANGUAGE=es-ES

# Wake word: a WakeNet model ("hiesp", "wn9_jarvis_tts"), "disabled", or a
# MultiNet custom command such as "custom:lila".
LILA_WAKE_WORD=custom:lila

# LCD/OLED panel symbol selected in menuconfig (the board defaults to OLED).
#   * 7-pin ST7789 240x240 without a CS line -> LCD_ST7789_240X240_7PIN (SPI mode 3)
#   * ST7789 240x240 wired with a CS line    -> LCD_ST7789_240X240     (SPI mode 0)
LILA_DISPLAY=LCD_ST7789_240X240_7PIN

# --- Optional tools (leave empty to disable a tool) ---
# `web.search` (Tavily web search). Get a key at https://tavily.com
LILA_TAVILY_API_KEY=
# `self.telegram.send`. Create a bot with @BotFather, then message it and read
# the chat id from https://api.telegram.org/bot<token>/getUpdates
LILA_TELEGRAM_BOT_TOKEN=
LILA_TELEGRAM_CHAT_ID=

# Extra raw sdkconfig assignments, space separated and applied last, e.g.
# LILA_SDKCONFIG=CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=15
LILA_SDKCONFIG=

# Set to 1 to also produce releases/<version>_<name>.zip
LILA_ZIP=0
